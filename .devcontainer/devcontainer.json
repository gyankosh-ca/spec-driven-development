{
  "name": "Spec-Driven Development",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "24" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "Expense splitter", "onAutoForward": "openBrowser" } },
  "customizations": {
    "codespaces": { "openFiles": ["STEPS.md"] },
    "vscode": {
      "settings": {
        "terminal.integrated.fontSize": 16,
        "editor.fontSize": 16,
        "workbench.editorAssociations": {
          "README.md": "vscode.markdown.preview.editor",
          "STEPS.md": "vscode.markdown.preview.editor",
          "**/take-home/*.md": "vscode.markdown.preview.editor"
        }
      },
      "extensions": ["GitHub.copilot", "GitHub.copilot-chat", "kilocode.kilo-code", "bierner.markdown-checkbox"]
    }
  }
}
